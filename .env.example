# Port d'ecoute du serveur HTTP
PORT=3000

# URL de base de l'API de geocodage Nominatim (sans slash final)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# URL de base de l'API de prevision Open-Meteo (sans slash final)
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# User-Agent exige par la politique d'usage de Nominatim :
# https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=tp-gestion-dependances/1.0 (contact: julien.andrade24@gmail.com)

# Timeout (ms) applique a chaque appel HTTP sortant (geocodage et meteo)
HTTP_TIMEOUT_MS=5000

# Fuseau horaire demande a Open-Meteo pour l'horodatage des previsions.
# "auto" = fuseau horaire deduit des coordonnees par Open-Meteo.
OPEN_METEO_TIMEZONE=auto

# --- TP2 : fournisseurs alternatifs (BAN, MET Norway) ---
# La selection GEOCODER_PROVIDER / WEATHER_PROVIDER arrive a l'etape 3.

# URL de base de l'API de geocodage BAN (Base Adresse Nationale, sans slash final)
BAN_BASE_URL=https://api-adresse.data.gouv.fr

# URL de base de l'API MET Norway (sans slash final)
MET_NORWAY_BASE_URL=https://api.met.no

# User-Agent exige par MET Norway (un User-Agent generique de librairie => 403) :
# https://api.met.no/doc/TermsOfService — format recommande : "<app>/<version> <contact>"
# Aucune valeur par defaut generique : a definir explicitement si MET Norway est utilise.
MET_NORWAY_USER_AGENT=TP2-MeteoApi/1.0 julien.andrade24@gmail.com
