# Port d'ecoute du serveur HTTP
PORT=3000

# URL de base de l'API de geocodage Nominatim (sans slash final)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# URL de base de l'API de prevision Open-Meteo (sans slash final)
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# User-Agent exige par la politique d'usage de Nominatim :
# https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=tp-gestion-dependances/1.0 (contact: julien.andrade24@gmail.com)

# Timeout (ms) applique a chaque appel HTTP sortant (geocodage et meteo)
HTTP_TIMEOUT_MS=5000

# Fuseau horaire demande a Open-Meteo pour l'horodatage des previsions.
# "auto" = fuseau horaire deduit des coordonnees par Open-Meteo.
OPEN_METEO_TIMEZONE=auto
